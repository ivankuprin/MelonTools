{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melon Tools",
  "version": "2.2.1",
  "identifier": "app.melontools.windows",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Melon Tools",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#1A1A1C"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    }
  }
}
